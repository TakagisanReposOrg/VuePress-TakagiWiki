---
import '@/styles/global.css';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>页面未找到 - 高木轻Wiki站</title>
    <meta name="description" content="你要找的页面不存在或已被移动。" />
    {/* 404 会被托管平台用于任何未命中路由，薄内容页若被索引会稀释站点质量 */}
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark =
        t === 'dark' ||
        ((t === null || t === 'system') &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="text-fd-primary text-6xl font-bold">404</p>
    <h1 class="mt-4 text-2xl font-semibold">页面被高木同学藏起来了</h1>
    <p class="text-fd-muted-foreground mt-2">你要找的页面不存在或已被移动。</p>
    <a
      href="/"
      class="text-fd-primary-foreground bg-fd-primary mt-8 rounded-xl px-6 py-3 font-medium transition-opacity hover:opacity-90"
    >
      返回首页
    </a>
  </body>
</html>
