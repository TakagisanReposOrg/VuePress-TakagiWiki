---
import { render, type CollectionEntry } from 'astro:content';
import { Docs } from '@/components/docs';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import SiteInfo from '@/components/site-info';
import VPCard from '@/components/vp-card';
import { Callout } from 'fumadocs-ui/components/callout';
import { Card, Cards } from 'fumadocs-ui/components/card';
import '@/styles/global.css';
import { source } from '@/lib/source';
import Layout from '@/components/layout.astro';
import type { TOCItemType } from 'fumadocs-core/toc';

interface Props {
  page: CollectionEntry<'docs'>;
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: {
      slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined,
    },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
// 兼容旧站的 .html URL（如 /music/ED.html）
const rawSlug =
  typeof Astro.params.slug === 'string' ? Astro.params.slug : '';
const slugs = rawSlug.replace(/\.html$/, '').split('/').filter(Boolean);
const docsPage = source.getPage(slugs);
if (!docsPage) {
  return Astro.redirect('/404.html');
}

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: '#' + heading.slug,
}));

const components = {
  ...defaultMdxComponents,
  SiteInfo,
  VPCard,
  Callout,
  Card,
  Cards,
};
---

<Layout title={page.data.title} description={page.data.description}>
  <meta property="og:image" content="/assets/logo.webp" />
  <Docs
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{
      toc,
      breadcrumb: { enabled: true },
    }}
    client:load
  >
    <h1 class="font-semibold text-3xl">{page.data.title}</h1>
    <div class="prose flex-1">
      <Content components={components} />
    </div>
    <div id="waline" class="mt-12"></div>
  </Docs>
  <script>
    // Waline 评论。
    // 注意：@waline/client 并不注册 <waline-comment> 自定义元素
    // （./component 导出的是 Vue 组件，./comment 只导出评论计数工具），
    // 必须通过 init() 显式挂载，否则创建出来的只是不渲染任何内容的未知元素。
    import('@waline/client').then(({ init }) => {
      if (!document.getElementById('waline')) return;
      const isDark = () => document.documentElement.classList.contains('dark');
      const instance = init({
        el: '#waline',
        serverURL: 'waline-1-v2731856.deta.app',
        emoji: ['//npm.onmicrosoft.cn/@waline/emojis@1.1.0/bilibili'],
        meta: ['nick', 'mail'],
        requiredMeta: ['nick'],
        commentSorting: 'hottest',
        pageSize: 5,
        dark: isDark() ? 'dark' : 'light',
        login: 'enable',
        wordLimit: 0,
        noCopyright: false,
      });
      // 主题切换后同步评论框配色
      const observer = new MutationObserver(() => {
        instance?.update({ dark: isDark() ? 'dark' : 'light' });
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    });
  </script>
</Layout>
