---
interface Props {
  title: string;
  description?: string;
  /** 覆盖默认规范地址，默认取当前路由的实际 URL */
  canonical?: string;
}

const {
  title,
  description = '《擅长捉弄的高木同学》轻Wiki站',
  canonical,
} = Astro.props;

// 规范地址以实际路由为准；Astro.site 来自 astro.config.mjs 的 site 配置。
// 旧站统一使用 .html 后缀（build.format: 'file'），Astro.url.pathname 已含该后缀，
// 因此这里得到的正是对外可访问的地址。
const canonicalURL = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? 'https://wiki.takagi3.cn',
);

// 社交分享卡片。必须写在 <head> 内：写在组件的 slot 里会被 Astro 渲染到
// <body> 起始处，Twitter / Facebook / Slack 等爬虫只解析 <head>，那样等于没写。
// 图片地址同样要绝对地址，相对路径在部分抓取端会解析失败。
const siteName = '高木轻Wiki站';
const ogImage = new URL(
  '/assets/logo.webp',
  Astro.site ?? 'https://wiki.takagi3.cn',
);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      // 提前应用主题，避免深色模式闪屏（与 fumadocs 的 'theme' 存储键一致）
      const t = localStorage.getItem('theme');
      const dark =
        t === 'dark' ||
        ((t === null || t === 'system') &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
